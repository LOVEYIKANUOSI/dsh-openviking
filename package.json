{
  "name": "dsh-openviking",
  "version": "0.2.0",
  "private": true,
  "description": "DeepSeek Harness 的 OpenViking 记忆插件：自动召回、增量捕获、compaction 前提交、OpenViking MCP 工具集；一键安装，附 Web 设置页",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "servers/",
    "cordis.patch.yml",
    "install.ps1",
    "install.sh",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}
